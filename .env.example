LOG_LEVEL=INFO

# Database (tables are created on startup; no migrations to run)
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=audit_log_management
MYSQL_HOST=localhost
MYSQL_PORT=3306
# MYSQL_USE_PURE=true   # only for local Windows runs where the C driver segfaults

# Validates bearer tokens for the read API
USER_MANAGER_URL=http://localhost:8080/api/v1

# Shared secret for POST /api/v1/audit/events. Must match the orchestrator's
# AUDIT_SERVICE_KEY. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUDIT_SERVICE_KEY=change-me

AUDIT_EXPORT_MAX_ROWS=50000
